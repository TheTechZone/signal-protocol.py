#!/bin/bash
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Get list of staged files
STAGED_RS=$(git diff --cached --name-only --diff-filter=d | grep "\.rs$" || true)
STAGED_PY=$(git diff --cached --name-only --diff-filter=d | grep "\.py$" || true)

# Rust checks
if [ ! -z "$STAGED_RS" ]; then
    echo -e "\n${YELLOW}Running Rust checks...${NC}"
    
    echo "Running cargo fmt..."
    cargo fmt -- --check
    
    # During development, we'll just warn about clippy issues
    echo "Running clippy (warnings only)..."
    cargo clippy || true
    
    echo "Running cargo check..."
    cargo check --all-targets
fi

# Python checks
if [ ! -z "$STAGED_PY" ]; then
    echo -e "\n${YELLOW}Running Python checks...${NC}"
    
    echo "Running ruff..."
    ruff check $STAGED_PY || true
    
    echo "Running black..."
    black --check $STAGED_PY || true
    
    echo "Running mypy..."
    mypy $STAGED_PY || true
fi

echo -e "${GREEN}Pre-commit checks complete!${NC}"
